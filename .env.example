VITE_PYTHON_API=http://localhost:8000
VITE_NODE_API=http://localhost:3000

DATABASE_URL=sqlite+aiosqlite:///./sirius.db

WEBHOOK_SECRET=test
NODE_API_URL=http://localhost:3000
INTERNAL_SECRET=test
PRICE_CHANGE_THRESHOLD_PCT=5.0
ANOMALY_ZSCORE_THRESHOLD=2.5

# Local development only: allow crawler to reach loopback/private addresses.
# Intended for local E2E tests. Never enable where crawler input is untrusted.
ALLOW_LOCAL_CRAWLS=False

# Competitor Discovery Engine (Phase 2)
# Search provider: "auto" | "tavily" | "serpapi" | "mock"
DISCOVERY_SEARCH_PROVIDER=auto
DISCOVERY_MAX_CANDIDATES=10

# Optional external search provider credentials.
# TAVILY_API_KEY=
# SERPAPI_API_KEY=
# When neither key is set, discovery falls back to MockSearchProvider
# (deterministic canned results) for offline testing only.

# Google OAuth 2.0 (Optional)
# Obtain from Google Cloud Console > APIs & Services > Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
